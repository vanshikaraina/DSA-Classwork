class Solution {
    public int[] findRedundantDirectedConnection(int[][] edges) {
        int n=edges.length;
        int[] parent=new int[n+1];

        int[] edge1=new int[2];
        int[] edge2=new int[2];

        for (int[] edge:edges) {
            int u=edge[0];
            int v=edge[1];

            if (parent[v]==0) {
                parent[v]=u;
            } else {
                edge1=new int[]{parent[v],v};
                edge2=new int[]{u,v};
                edge[1]=0;
            }
        }

        for (int i=1;i<=n;i++) {
            parent[i]=i;
        }

        for (int[] edge:edges) {
            int u=edge[0];
            int v=edge[1];

            if (v==0) continue;

            int pu=find(parent, u);
            int pv=find(parent, v);

            if (pu==pv) {
                if (edge1[0]==0) {
                    return edge;
                }
                return edge1;
            }

            parent[pu]=pv;
        }

        return edge2;
    }

    private int find(int[] parent, int x) {
        if (parent[x]!=x) {
            parent[x]=find(parent, parent[x]);
        }
        return parent[x];
    }
}
